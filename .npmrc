# ──────────────────────────────────────────────────────────────────────
# npm-compatible project config
#
# pnpm-only security and reproducibility settings live in
# `pnpm-workspace.yaml` so npm CLI commands do not warn about unknown keys.
# ──────────────────────────────────────────────────────────────────────

# ── Version pinning ───────────────────────────────────────────────────
# Installs write exact versions to package.json (no ^ / ~ drift).
save-exact=true
save-prefix=

# ── Engine strictness ─────────────────────────────────────────────────
# Enforce the node/pnpm versions declared in package.json > engines.
engine-strict=true

# ── Audit ─────────────────────────────────────────────────────────────
# `pnpm audit` fails on moderate+ advisories.
audit-level=moderate
