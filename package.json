{
  "name": "browser-recorder",
  "version": "0.2.0",
  "description": "Record a real browser session into a faithful, plain Patchright script, managed from a terminal UI",
  "keywords": [
    "browser-automation",
    "browser-recording",
    "browser-recorder",
    "cli",
    "e2e-testing",
    "patchright",
    "test-automation"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Juan José González (https://github.com/juanjoGonDev)",
  "homepage": "https://github.com/juanjoGonDev/browser-recorder#readme",
  "bugs": {
    "url": "https://github.com/juanjoGonDev/browser-recorder/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juanjoGonDev/browser-recorder.git"
  },
  "type": "module",
  "bin": {
    "browser-recorder": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "pnpm run build && node dist/main.js",
    "replay": "pnpm run --silent build && node dist/main.js replay",
    "build": "node --experimental-strip-types scripts/build.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deadcode": "knip",
    "deps:check": "depcruise src scripts --config .dependency-cruiser.json --ts-config tsconfig.node.json && depcruise tests --config .dependency-cruiser.tests.json --ts-config tsconfig.tests.json",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:in-page && pnpm typecheck:tests",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:in-page": "tsc -p tsconfig.in-page.json",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "quality": "pnpm typecheck && pnpm lint:strict && pnpm format:check && pnpm deadcode && pnpm deps:check && pnpm test",
    "audit": "pnpm audit --audit-level=moderate",
    "prepare": "node --experimental-strip-types scripts/install-hooks.ts"
  },
  "dependencies": {
    "patchright": "1.63.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/eslint-plugin": "1.6.27",
    "dependency-cruiser": "18.5.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-unicorn": "77.0.0",
    "jiti": "2.7.0",
    "knip": "6.40.0",
    "lefthook": "2.1.17",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
