node_modules/
dist/
.DS_Store
*.log

# Local AI tooling state (skill registry cache) — not project config.
.atl/

# This project uses pnpm exclusively. Guard against a stray `npm install`
# committing an npm/yarn lockfile alongside pnpm-lock.yaml.
package-lock.json
yarn.lock

coverage/

# Recorded sessions are local-only: they hold plaintext values typed during
# a recording (see SECURITY.md), so they must never be committed.
recordings/

# Atomic-write temp files left behind by an interrupted write.
*.tmp
