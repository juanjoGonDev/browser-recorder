  {
    "name": "copy of a real profile keeps the real keychain",
    "display": { "kind": "window", "width": 1024, "height": 768 },
    "target": {
      "executablePath": "/fixture/Chrome",
      "browserArgs": ["--profile-directory=Profile 2"],
      "shouldUseRealKeychain": true
    },
    "expected": {
      "viewport": null,
      "args": ["--window-size=1024,768", "--profile-directory=Profile 2"],
      "ignoreDefaultArgs": ["--use-mock-keychain", "--password-store=basic"],
      "executablePath": "/fixture/Chrome"
    }
  }
